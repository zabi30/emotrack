# Expo / App
EXPO_PUBLIC_APP_ENV=production

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Face++ (optional, disabled by default)
EXPO_PUBLIC_FACEPP_ENABLED=false
EXPO_PUBLIC_FACEPP_API_KEY=
EXPO_PUBLIC_FACEPP_API_SECRET=

# Hugging Face (optional)
EXPO_PUBLIC_HF_API_TOKEN=
EXPO_PUBLIC_HF_EMOTION_MODEL=trpakov/vit-face-expression
EXPO_PUBLIC_HF_ENDPOINT=https://router.huggingface.co/hf-inference
EXPO_PUBLIC_HF_TIMEOUT_MS=12000
EXPO_PUBLIC_HF_RETRIES=2

# Azure Face API (optional)
EXPO_PUBLIC_AZURE_ENABLED=false
EXPO_PUBLIC_AZURE_API_KEY=
EXPO_PUBLIC_AZURE_ENDPOINT=

# Google Vision (optional)
EXPO_PUBLIC_GOOGLE_VISION_ENABLED=false
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=
